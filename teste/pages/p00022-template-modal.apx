page 22 (
    name: "Apply Band Template"
    alias: TEMPLATE-MODAL
    title: "Apply Band Template"
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region form (
        name: "Select Template"
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P22_SERVICE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P22_TEMPLATE_ID (
        type: selectList
        label {
            label: "Band Template"
            alignment: left
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT name || ' (' || NVL(description, 'Standard') || ')' AS d, id AS r
                FROM ws_service_templates
                ORDER BY name ASC
                ```
            displayNullValue: true
        }
        validation {
            valueRequired: true
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button apply (
        buttonName: APPLY
        label: "Apply Template"
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            icon: fa-clone
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: "Cancel Dialog"
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process apply_template (
        name: "Apply Template"
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    ws_pkg_scheduler.apply_template(
                        p_service_id  => TO_NUMBER(:P22_SERVICE_ID),
                        p_template_id => TO_NUMBER(:P22_TEMPLATE_ID)
                    );
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: "Template slots successfully instantiated!"
        }
        serverSideCondition {
            whenButtonPressed: @apply
        }
    )

    process close_dialog (
        name: "Close Dialog"
        type: closeDialog
        execution {
            sequence: 20
        }
    )

)
