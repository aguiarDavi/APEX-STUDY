page 11 (
    name: "Decline Invitation"
    alias: DECLINE-DRAWER
    title: "Decline Invitation"
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @ws-auth-musician
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region form (
        name: "Decline Details"
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P11_ROSTER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_ROW_VERSION (
        type: hidden
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_REASON (
        type: textarea
        label {
            label: "Reason for Declining (Optional)"
            alignment: left
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
            valuePlaceholder: "e.g., Out of town, Work shift, Family event..."
        }
        validation {
            maxLength: 255
        }
        help {
            helpText: "Provide an optional reason explaining why you are declining this service invitation."
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirm-decline (
        buttonName: DECLINE
        label: "Confirm Decline"
        layout {
            sequence: 20
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            icon: fa-times
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: "Cancel Dialog"
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process execute_decline (
        name: "Execute Decline"
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    ws_pkg_musician_portal.decline_invitation(
                        p_roster_id   => TO_NUMBER(:P11_ROSTER_ID),
                        p_reason      => :P11_REASON,
                        p_row_version => TO_NUMBER(:P11_ROW_VERSION)
                    );
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        successMessage {
            successMessage: "Invitation declined. The worship leader has been notified."
        }
        serverSideCondition {
            whenButtonPressed: @confirm-decline
        }
    )

    process close_dialog (
        name: "Close Dialog"
        type: closeDialog
        execution {
            sequence: 20
        }
    )

)
