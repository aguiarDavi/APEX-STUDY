list navigation-bar (
    name: Navigation Bar

    entry theme-toggle (
        label: "Alternar Tema"
        icon {
            imageIconCssClasses: fa-moon-o
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                type: url
                url: javascript:void(0);
            }
        }
        userDefinedAttributes {
            2: "t-Button--noLabel js-theme-toggle"
            4: "Alternar Tema Claro/Escuro"
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry musician-portal (
        label: "Musician Portal"
        icon {
            imageIconCssClasses: fa-music
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry leader-matrix (
        label: "Scheduling Matrix"
        icon {
            imageIconCssClasses: fa-calendar-check-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 20
            }
        }
    )

    entry song-repertoire (
        label: "Song Repertoire"
        icon {
            imageIconCssClasses: fa-book
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 30
            }
        }
    )

)



